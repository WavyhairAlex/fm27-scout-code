{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FM27 Scout",
  "identifier": "com.fm27scout.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FM27 Scout",
        "width": 1480,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/shlk20/fm27-scout-code/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Football Manager 27 scout and save editor",
    "longDescription": "A local Football Manager 27 scout with an optional save editor. Read commands never modify saves; editing writes a new save file. No network access.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "fm"
        ],
        "name": "Football Manager Save",
        "description": "Football Manager career save",
        "mimeType": "application/octet-stream",
        "role": "Viewer"
      }
    ]
  }
}
